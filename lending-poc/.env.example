POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lending_poc
POSTGRES_HOST_PORT=55439
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:55439/lending_poc
ENCRYPTION_KEY=changeme-generate-a-base64-fernet-key
DEBUG=true

# Selects the surya-inference/ocr variant docker-compose.yml runs: "cpu"
# (default, always works) or "gpu" (requires an NVIDIA GPU + NVIDIA
# Container Toolkit / WSL GPU passthrough on the host).
COMPOSE_PROFILES=cpu

# Model used by the translation and field_mapping services via Ollama.
# Must be pulled into the ollama container first:
#   docker compose exec ollama ollama pull <model>
OLLAMA_MODEL=gemma4:e4b-it-qat
# OLLAMA_HOST=http://ollama:11434

# Redis used by the Celery workers: db 0 = task queue (broker), db 1 = task
# results. These localhost values are for bare-metal runs only — under
# docker compose they're overridden to point at the "redis" container.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# How long (seconds) the gateway waits for one HTTP call to each backend.
# OCR, translation (text) and field mapping only queue work for a Celery
# worker, so these are short; /translate/files and /cases still do their
# work inside the request.
# OCR_REQUEST_TIMEOUT_SECONDS=120
# TRANSLATION_REQUEST_TIMEOUT_SECONDS=300
# FIELD_MAPPING_REQUEST_TIMEOUT_SECONDS=30
# APP_REQUEST_TIMEOUT_SECONDS=300

# How long (seconds) the work itself may run inside a worker. Raise these on
# slow CPU-only hosts, where handwritten OCR pages or long translations can
# legitimately take longer.
# Read-phase ceiling for each Ollama call (translation and field mapping):
# OLLAMA_TIMEOUT_SECONDS=600
# OCR_TASK_TIME_LIMIT_SECONDS=600
