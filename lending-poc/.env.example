POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lending_poc
POSTGRES_HOST_PORT=55439
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:55439/lending_poc
ENCRYPTION_KEY=changeme-generate-a-base64-fernet-key
DEBUG=true

# Selects the surya-inference/ocr variant docker-compose.yml runs: "cpu"
# (default, always works) or "gpu" (requires an NVIDIA GPU + NVIDIA
# Container Toolkit / WSL GPU passthrough on the host).
COMPOSE_PROFILES=cpu

# Model used by the translation and field_mapping services via Ollama.
# Must be pulled into the ollama container first:
#   docker compose exec ollama ollama pull <model>
OLLAMA_MODEL=gemma4:e4b-it-qat
# OLLAMA_HOST=http://ollama:11434

# How long (seconds) the gateway waits on each backend before giving up.
# Defaults already match what the frontend budgets for these same calls —
# only override if you've changed the frontend's timeouts too.
# OCR_REQUEST_TIMEOUT_SECONDS=300
# TRANSLATION_REQUEST_TIMEOUT_SECONDS=300
# FIELD_MAPPING_REQUEST_TIMEOUT_SECONDS=300
# APP_REQUEST_TIMEOUT_SECONDS=300

# Client-level default only — every proxied route passes its own per-request
# timeout above, which overrides this.
# GATEWAY_CLIENT_TIMEOUT_SECONDS=120

# Read-phase ceiling for Ollama calls in translation and field-mapping.
# OLLAMA_TIMEOUT_SECONDS=600

# --- Validation pipeline tuning -----------------------------------------
# These are the same values app/services/validation_config.py falls back to,
# spelled out here so every knob is visible in one place. Edit in place.

# Documents an application must contain, or it hard-FAILs. Comma-separated.
REQUIRED_DOCUMENT_TYPES=AADHAAR,PAN,SALARY_SLIP,BANK_STATEMENT

# Fuzzy-match score (0-100) a name/employer comparison must reach to pass.
NAME_MATCH_THRESHOLD=85.0
EMPLOYER_MATCH_THRESHOLD=80.0

# How wide a window around a salary month to search the bank statement for
# that month's credit: from BUFFER_DAYS before the month starts, through the
# end of the month EXTRA_MONTHS later.
SALARY_CREDIT_EXTRA_MONTHS=1
SALARY_CREDIT_BUFFER_DAYS=5

# How a candidate salary credit is scored (employer-narration match vs.
# amount closeness) and the minimum score to accept one at all.
TXN_SELECTION_EMPLOYER_WEIGHT=0.70
TXN_SELECTION_AMOUNT_WEIGHT=0.30
TXN_SELECTION_MIN_SCORE=60.0

# Hard gate: a transaction must be within this % of the slip's net_salary to
# be eligible as a salary credit at all, however well its narration scores.
# Raising it lets a same-employer bonus/reimbursement mask a missing salary.
SALARY_AMOUNT_TOLERANCE_PCT=3.0

# Relative weights of each check type in the overall score. Ratios, not
# percentages -- they need not sum to 1.0, since the score renormalizes by
# the checks a case actually produced. Which check types exist is fixed in
# code; only their weights are tunable here.
VALIDATION_WEIGHT_NAME=0.15
VALIDATION_WEIGHT_DOB=0.10
VALIDATION_WEIGHT_EMPLOYER=0.10
VALIDATION_WEIGHT_SALARY_CREDIT_COUNT=0.25
VALIDATION_WEIGHT_SALARY_CONTINUITY=0.10

# Score cutoffs: >= PASS -> PASS, < FAIL -> FAIL, in between -> NEEDS_REVIEW.
DECISION_PASS_THRESHOLD=90.0
DECISION_FAIL_THRESHOLD=60.0
