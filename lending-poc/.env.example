# Used when running the app/Alembic from the host (matches docker-compose's published port).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:55432/lending_poc
# Used by the `app` service inside docker-compose (talks to `db` over the Docker network).
DATABASE_URL_DOCKER=postgresql+asyncpg://postgres:postgres@db:5432/lending_poc

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lending_poc
POSTGRES_HOST_PORT=55432

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

APP_NAME=lending-poc
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
