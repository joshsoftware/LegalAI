VITE_API_BASE_URL=http://localhost:8080
VITE_TRANSLATION_API_BASE_URL=http://localhost:8080

# Per-call request timeouts (ms). Defaults match what the gateway's own
# per-service timeouts budget for the same calls — only override if you've
# changed the gateway/backend timeouts too.
# VITE_DEFAULT_TIMEOUT_MS=30000
# VITE_EXTRACT_TIMEOUT_MS=300000
# VITE_MAP_FIELDS_TIMEOUT_MS=300000
# VITE_TRANSLATE_TIMEOUT_MS=300000

# Max upload size (MB). Must match the backend's MAX_UPLOAD_FILE_SIZE_MB.
# VITE_MAX_UPLOAD_FILE_SIZE_MB=50
