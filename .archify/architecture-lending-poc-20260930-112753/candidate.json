  "cards": [
    {
      "dot": "cyan",
      "title": "Main journey (browser drives each step)",
      "items": [
        "Upload → POST /extract per file → OCR text + HTML",
        "OCR text → POST /translate/text (domain: banking)",
        "Translated text → POST /map with a per-document schema",
        "Mapped fields → POST /cases → PASS / FAIL / NEEDS_REVIEW",
        "Cases API runs golden record → identity + business checks → score → decision, then saves everything in one transaction"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Only :8080 (gateway) and :5173 (frontend) are published to the host",
        "The gateway has no authentication and allows CORS from any origin",
        "Internal services listen on 127.0.0.1 inside the backend container; Postgres, Redis and Ollama publish no host port",
        "Aadhaar and PAN numbers are Fernet-encrypted in golden_records; PAN is masked in document JSON",
        "Only outbound internet traffic: HuggingFace model downloads (and manual `ollama pull`)"
      ]
    },
    {
      "dot": "amber",
      "title": "Caveats",
      "items": [
        "Diagram reflects commit 32af988; the Celery/Redis task flow on this branch is still uncommitted",
        "OCR, translation and mapping each process one request at a time (asyncio lock)",
        "Timeouts temporarily raised to 1800 s (marked TEMP in code)",
        "Extraction/ (legal-case pipeline) is a separate project and is not shown"
      ]
    }
  ]
